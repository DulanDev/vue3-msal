{
  "name": "vue3-msal-plugin",
  "version": "1.1.1",
  "description": "Vue 3 plugin for integrating MSAL.js into your app, offering easy-to-use composables.",
  "author": {
    "name": "Dulan Katukurundage",
    "email": "dulanhewage2@hotmail.com",
    "url": "https://dulan.me"
  },
  "keywords": [
    "vue",
    "vue3",
    "msal",
    "microsoft",
    "authentication",
    "library",
    "plugin",
    "msal-browser",
    "azure-ad"
  ],
  "type": "module",
  "files": [
    "lib/*",
    "CHANGELOG.md"
  ],
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "import": "./lib/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "sideEffects": false,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build/build.js && npm run generate:types",
    "generate:types": "tsc -p tsconfig.json",
    "lint": "eslint . --fix",
    "prettier": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "release:major": "npm version $(semver $npm_package_version -i major) && npm publish --tag latest",
    "release:minor": "npm version $(semver $npm_package_version -i minor) && npm publish --tag latest",
    "release:patch": "npm version $(semver $npm_package_version -i patch) && npm publish --tag latest"
  },
  "homepage": "https://github.com/DulanDev/vue3-msal#readme",
  "peerDependencies": {
    "@azure/msal-browser": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@babel/types": "^7.24.0",
    "@types/node": "^20.19.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.5.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10",
    "vue": "^3.5.0"
  }
}
